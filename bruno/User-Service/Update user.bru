meta {
  name: Update user
  type: http
  seq: 3
}

put {
  url: {{URL}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "userId":10,
    "firstName":"Bob",
    "surname":"Alice",
    "email":"bob.alice@gmail.com",
    "phoneNumber":"0123456789",
    "language":"FR",
    "acceptsNotifications": true,
    "acceptsLocationSharing": false
  }
}

tests {
  expect(res.status).to.be.oneOf([200, 204]);
}
