meta {
  name: Create spectator
  type: http
  seq: 4
}

post {
  url: {{URL}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "firstName":"Bob",
    "surname":"Alice",
    "email":"bob.alice@gmail.com",
    "phoneNumber":"0123456789",
    "language":"FR",
    "acceptsNotifications": true,
    "acceptsLocationSharing": false
  }
}

tests {
  expect(res.status).to.be.oneOf([201, 200]);
  expect(res.body).to.not.be.null;
}
