meta {
  name: CreateSubscription
  type: http
  seq: 6
}

post {
  url: {{URL}}/subscriptions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "userId": "user123",
    "notificationType": "ALERT",
    "targetType": "GLOBAL",
    "targetId": null
  }
}

test {
  expect response.status == 201 || response.status == 200
  expect response.body.id != null
}
