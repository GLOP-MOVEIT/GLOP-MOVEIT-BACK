meta {
  name: CreateNotification
  type: http
  seq: 2
}

post {
  url: {{URL}}/notifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "title": "Titre de la notif",
    "content": "Test notification Bruno",
    "notificationType": "ALERT",
    "targetType": "GLOBAL",
    "targetId": null
  }
}

tests {
  expect(res.status).to.be.oneOf([201, 200]);
  expect(res.body).to.not.be.null;
}
