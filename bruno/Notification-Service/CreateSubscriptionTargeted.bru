meta {
  name: CreateSubscriptionTargeted
  type: http
  seq: 7
}

post {
  url: {{URL}}/subscriptions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "userId": "user123",
    "notificationType": "RESULT",
    "targetType": "COMPETITION",
    "targetId": 42
  }
}

test {
  expect response.status == 201 || response.status == 200
  expect response.body.id != null
}
