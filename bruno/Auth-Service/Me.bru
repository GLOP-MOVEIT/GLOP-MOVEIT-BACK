meta {
  name: Me
  type: http
  seq: 3
}

get {
  url: {{URL}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "email": "test@test.fr",
    "password": "password"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("USER_ID", res.body.id);
  }
}