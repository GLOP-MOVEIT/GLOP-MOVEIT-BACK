meta {
  name: Create athlete request
  type: http
  seq: 4
}

post {
  url: {{URL}}/requests/athlete/:userId
  body: json
  auth: bearer
}

params:path {
  userId: {{USER_ID}}
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "firstName":"Bob",
    "surname":"Alice",
    "email":"bob.alice@gmail.com",
    "phoneNumber":"0123456789",
    "language":"FR",
    "acceptsNotifications": true,
    "acceptsLocationSharing": false
  }
}

tests {
  expect(res.status).to.be.oneOf([201, 200]);
}