meta {
  name: Create volunteer request
  type: http
  seq: 4
}

post {
  url: {{URL}}/requests/volunteer/:userId
  body: json
  auth: bearer
}

params:path {
  userId: {{USER_ID}}
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "coverLetterDocument":"J'aimerais bien être volontaire."
  }
}

tests {
  expect(res.status).to.be.oneOf([201, 200]);
}