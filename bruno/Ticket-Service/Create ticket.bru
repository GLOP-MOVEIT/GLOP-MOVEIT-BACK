meta {
  name: Create ticket
  type: http
  seq: 4
}

post {
  url: {{URL}}/tickets/:userId
  body: json
  auth: bearer
}

params:path {
  userId: 
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

body:json {
  {
    "ticketNumber":"6542",
    "seatInformation":"Place 15",
    "eventDate":"2026-06-20T19:30:00Z"
  }
}

test {
  expect response.status == 201 || response.status == 200
  expect response.body.id != null
}
